# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BOOSTIFY ADMIN ACCESS & BOOTSTRAP (Server-side validation)
# Used for initial server-side bootstrap authorization for the private admin panel.
# Default development code is 'saify2026'
ADMIN_BOOTSTRAP_CODE="saify2026"

# FIREBASE CONFIGURATION (Spark Free Plan Compatible)
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
